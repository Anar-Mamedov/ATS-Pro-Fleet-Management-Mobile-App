{
  "expo": {
    "name": "ATS Pro",
    "slug": "ATS-Pro-Mobile-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "atspromobileapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "primaryColor": "#007AFF",
    "description": "ATS Pro - Fleet management application for drivers and managers. Track vehicles, manage maintenance, reports and documents.",
    "privacy": "https://atspro.com.tr/privacy-policy",
    "githubUrl": "https://github.com/Anar-Mamedov/ATS-Pro-Fleet-Management-Mobile-App.git",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.orjinyazilim.atspro",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Uygulama kameranızı kullanmak için izin gerekiyor.",
        "NSPhotoLibraryUsageDescription": "Uygulama fotoğraflarınıza erişmek için izin gerekiyor.",
        "NSMicrophoneUsageDescription": "Uygulama mikrofonunuzu kullanmak için izin gerekiyor."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.orjinyazilim.atspro",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "permissions": ["android.permission.CAMERA", "android.permission.READ_EXTERNAL_STORAGE", "android.permission.WRITE_EXTERNAL_STORAGE", "android.permission.RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/splash-icon-white.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Uygulama fotoğraflarınıza erişmek için izin gerekiyor.",
          "cameraPermission": "Uygulama kameranızı kullanmak için izin gerekiyor."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Uygulama kameranızı kullanmak için izin gerekiyor.",
          "microphonePermission": "Uygulama mikrofonunuzu kullanmak için izin gerekiyor.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-network-security-config",
        {
          "networkSecurityConfig": "./plugins/network_security_config.xml",
          "enable": true
        }
      ],
      "./plugins/copy-sectigo-cert.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a833e92e-525a-46e3-ac3d-199e55743a38"
      }
    },
    "owner": "anar_mammadov"
  }
}
